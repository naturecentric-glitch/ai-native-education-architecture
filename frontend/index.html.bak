<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🎓 AI-Native Education Platform</title>
    <style>
        :root {
            --primary: #4A90D9;
            --success: #2ECC71;
            --warning: #F39C12;
            --danger: #E74C3C;
            --bg: #F5F7FA;
            --card: #FFFFFF;
            --text: #2C3E50;
            --text-light: #7F8C8D;
            --border: #E1E8ED;
            --radius: 14px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
        }

        /* ── Hero ───────────────────────────────────────────── */
        .hero {
            background: linear-gradient(135deg, #4A90D9 0%, #2C5F8A 50%, #1A3A5C 100%);
            color: white;
            text-align: center;
            padding: 4rem 2rem 3rem;
            position: relative;
            overflow: hidden;
        }
        .hero::before {
            content: '';
            position: absolute;
            top: -50%; left: -50%;
            width: 200%; height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);
            animation: float 20s ease-in-out infinite;
        }
        @keyframes float {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(30px, -30px); }
        }
        .hero h1 {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            position: relative;
        }
        .hero p {
            font-size: 1.1rem;
            opacity: 0.9;
            max-width: 600px;
            margin: 0 auto;
            position: relative;
        }
        .hero .subtitle {
            margin-top: 1rem;
            font-size: 0.85rem;
            opacity: 0.7;
        }

        /* ── Course Grid ────────────────────────────────────── */
        .section {
            max-width: 1000px;
            margin: 0 auto;
            padding: 2rem 1.5rem;
        }
        .section-title {
            font-size: 1.4rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .course-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
        }
        .course-card {
            background: var(--card);
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            transition: transform 0.2s, box-shadow 0.2s;
            cursor: pointer;
            display: flex;
            flex-direction: column;
        }
        .course-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.12);
        }
        .course-card .card-banner {
            height: 120px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3.5rem;
            position: relative;
        }
        .course-card .card-banner::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0; right: 0;
            height: 40px;
            background: linear-gradient(to top, var(--card), transparent);
        }
        .course-card .card-body {
            padding: 1.25rem;
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        .course-card .card-body h3 {
            font-size: 1.1rem;
            margin-bottom: 0.35rem;
        }
        .course-card .card-body .description {
            font-size: 0.85rem;
            color: var(--text-light);
            flex: 1;
            margin-bottom: 1rem;
        }
        .course-card .card-meta {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        .badge {
            padding: 0.2rem 0.6rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
        }
        .badge.grade { background: #E3F2FD; color: #1565C0; }
        .badge.board { background: #E8F5E9; color: #2E7D32; }
        .badge.subject { background: #FFF3E0; color: #E65100; }
        .badge.status-active { background: #E8F5E9; color: #2E7D32; }
        .badge.status-coming { background: #FFF8E1; color: #F57F17; }

        /* ── Empty / Loading ────────────────────────────────── */
        .loading-state, .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--text-light);
        }
        .spinner {
            width: 40px; height: 40px;
            border: 4px solid var(--border);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin: 0 auto 1rem;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* ── Footer ─────────────────────────────────────────── */
        .footer {
            text-align: center;
            padding: 2rem;
            font-size: 0.8rem;
            color: var(--text-light);
            border-top: 1px solid var(--border);
            margin-top: 2rem;
        }

        @media (max-width: 600px) {
            .hero h1 { font-size: 1.8rem; }
            .course-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<!-- Hero -->
<div class="hero">
    <h1>🎓 AI-Native Education</h1>
    <p>Mastery-based learning powered by AI. Pick a course below and let your personal tutor guide you through every concept.</p>
    <div class="subtitle">Personalized • Adaptive • Mastery-Driven</div>
</div>

<!-- Courses Section -->
<div class="section">
    <div class="section-title">📚 Available Courses</div>

    <div id="loadingState" class="loading-state">
        <div class="spinner"></div>
        <p>Loading courses...</p>
    </div>

    <div id="emptyState" class="empty-state" style="display:none">
        <p style="font-size:1.5rem;margin-bottom:0.5rem">📭</p>
        <p>No courses available yet. Check back soon!</p>
    </div>

    <div class="course-grid" id="courseGrid"></div>
</div>

<!-- Footer -->
<div class="footer">
    AI-Native Education Platform &middot; Built with Gemini AI &middot; <a href="https://github.com/naturecentric-glitch/ai-native-education-architecture" target="_blank" style="color:var(--primary)">GitHub</a>
</div>

<script>
async function loadCourses() {
    const grid = document.getElementById('courseGrid');
    const loading = document.getElementById('loadingState');
    const empty = document.getElementById('emptyState');

    try {
        const res = await fetch('/api/courses');
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const courses = data.courses || [];

        loading.style.display = 'none';

        if (courses.length === 0) {
            empty.style.display = 'block';
            return;
        }

        for (const course of courses) {
            const card = document.createElement('div');
            card.className = 'course-card';
            card.onclick = () => {
                window.location.href = `/course/${course.course_id}`;
            };

            const color = course.color || '#4A90D9';
            card.innerHTML = `
                <div class="card-banner" style="background: linear-gradient(135deg, ${color}22, ${color}44);">
                    ${course.icon || '📖'}
                </div>
                <div class="card-body">
                    <h3>${course.title}</h3>
                    <div class="description">${course.description || ''}</div>
                    <div class="card-meta">
                        <span class="badge grade">Grade ${course.grade}</span>
                        <span class="badge board">${course.board || 'General'}</span>
                        <span class="badge subject">${course.subject}</span>
                    </div>
                </div>
            `;
            grid.appendChild(card);
        }
    } catch (e) {
        console.error('Failed to load courses:', e);
        loading.innerHTML = '<p style="color:#E74C3C">❌ Failed to load courses. Is the server running?</p>';
    }
}

loadCourses();
</script>

</body>
</html>
